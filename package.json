    },
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "bench": "vitest bench --run --config bench/vitest.config.ts",
        "lint": "oxlint",
        "test": "vitest run",
        "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.bench.json",
        "extract-fixtures": "node scripts/extract-spec-playlists.ts"
    },
    "dependencies": {
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/m3u8-parser": "^7.2.6",
